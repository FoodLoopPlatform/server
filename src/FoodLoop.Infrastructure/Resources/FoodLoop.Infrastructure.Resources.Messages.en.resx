<?xml version="1.0" encoding="utf-8"?>
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype"><value>text/microsoft-resx</value></resheader>
  <resheader name="version"><value>2.0</value></resheader>
  <resheader name="reader"><value>System.Resources.ResXResourceReader, System.Windows.Forms</value></resheader>
  <resheader name="writer"><value>System.Resources.ResXResourceWriter, System.Windows.Forms</value></resheader>

  <!-- Auth -->
  <data name="InvalidEmailOrPassword"><value>Invalid email or password.</value></data>
  <data name="AccountNotActive"><value>This account is not active. Please contact support.</value></data>
  <data name="EmailAlreadyRegistered"><value>Email is already registered.</value></data>
  <data name="PhoneAlreadyRegistered"><value>Phone number is already registered.</value></data>
  <data name="InvalidRole"><value>Invalid role '{0}'. Expected one of: {1}.</value></data>
  <data name="BusinessNameRequired"><value>Business or organization name is required.</value></data>
  <data name="RegistrationFailed"><value>Registration failed.</value></data>
  <data name="InvalidResetRequest"><value>Invalid request.</value></data>
  <data name="UnableToResetPassword"><value>Unable to reset password.</value></data>

  <!-- Store -->
  <data name="StoreNotFound"><value>No store was found for this account. Business accounts get a draft store automatically at registration.</value></data>
  <data name="StoreNotFoundByEmail"><value>No store was found for the provided email. Make sure you registered as a Merchant account.</value></data>
  <data name="StoreNotFoundById"><value>Store not found.</value></data>
  <data name="UnknownDocumentType"><value>Unknown document type '{0}'. Expected one of: {1}.</value></data>
  <data name="OwnerEmailRequired"><value>The owner email is required to link documents to an account.</value></data>
  <data name="FileRequired"><value>A file is required.</value></data>
  <data name="UnableToDeleteUser"><value>Failed to delete user. The user might have active relationships (e.g. store, orders) preventing deletion.</value></data>

  <!-- Address -->
  <data name="CannotDeleteOtherUserAddress"><value>You cannot delete another user's address.</value></data>
  <data name="CannotModifyOtherUserAddress"><value>You cannot modify another user's address.</value></data>

  <data name="FailedToCreateUser"><value>Failed to create user.</value></data>
  <data name="FailedToUpdateUser"><value>Failed to update user.</value></data>
  <data name="FailedToDeleteUser"><value>Failed to delete user.</value></data>
  <data name="InvalidUserStatus"><value>Invalid user status '{0}'. Expected values: {1}.</value></data>

  <data name="InvalidRefreshToken"><value>Invalid refresh token.</value></data>
  <data name="RefreshTokenExpired"><value>Refresh token is no longer valid. Please log in again.</value></data>
  <data name="AccountNotAvailable"><value>Account is not available.</value></data>

  <!-- Generic -->
  <data name="Unauthorized"><value>Unauthorized.</value></data>
  <data name="UnexpectedError"><value>An unexpected error occurred.</value></data>
  <data name="PreferencesUpdated"><value>Preferences updated.</value></data>
  <data name="LoggedOut"><value>Logged out.</value></data>
  <data name="PasswordReset"><value>Password has been reset.</value></data>
  <data name="ForgotPasswordSent"><value>If that email is registered, a reset link has been sent.</value></data>
  <data name="ListingDeletedSuccessfully"><value>Product listing deleted successfully.</value></data>
</root>
